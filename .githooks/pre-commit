#!/bin/sh
# Photon pre-commit hook: Linter + Prettier muessen vor jedem Commit sauber sein.
# Aktivieren: git config core.hooksPath .githooks

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1

if [ ! -x script/node_modules/.bin/eslint ]; then
  echo "pre-commit: script/node_modules fehlt. Bitte zuerst 'script/bootstrap' ausfuehren." >&2
  exit 1
fi

# Prettier fuer gestagte Dateien, die ESLint nicht abdeckt (JSON, Markdown, Less/CSS)
staged="$(git diff --cached --name-only --diff-filter=ACMR -- '*.json' '*.md' '*.less' '*.css' \
  ':!**/package-lock.json' ':!**/node_modules/**' ':!vendor/**' ':!spec/fixtures/**')"
if [ -n "$staged" ]; then
  # shellcheck disable=SC2086
  if ! echo "$staged" | xargs script/node_modules/.bin/prettier --list-different; then
    echo "pre-commit: Prettier-Abweichungen in den oben genannten Dateien." >&2
    echo "  Beheben: script/node_modules/.bin/prettier --write <datei>" >&2
    exit 1
  fi
fi

echo "pre-commit: node script/lint ..."
if ! node script/lint; then
  echo "pre-commit: Lint-Fehler. 'node script/lint --fix' behebt vieles automatisch." >&2
  exit 1
fi

# CHANGELOG-Erinnerung (nur Warnung)
if ! git diff --cached --name-only | grep -qx 'CHANGELOG.md'; then
  echo "pre-commit: Hinweis: CHANGELOG.md ist nicht gestagt. Gehoert die Aenderung unter [Unreleased]?" >&2
fi

exit 0
